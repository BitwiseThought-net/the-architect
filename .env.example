# --- CORE CONFIG ---

# Model selection
MODEL_NAME=qwen3.8:latest

# --- PORTS ---
LITELLM_PORT=4000
UI_PORT=3000

# --- BOOT SECURITY ---
WEBUI_SECRET_KEY=
ENABLE_SIGNUP=false

# --- DOCKER NETWORKING ---
OLLAMA_BASE_URL=http://ai-ollama:11434
LITELLM_BASE_URL=http://ai-litellm:4000/v1

# --- NOTIFICATIONS ---
NOTIFY_WEBHOOK_URL=

OLLAMA_PORT=11434
LITELLM_MASTER_KEY=
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE

SEARXNG_QUERY_URL="http://searxng:8080/search?q=<query>"


# Read the documentation before using the `docker-compose.yml` file:
# https://docs.searxng.org/admin/installation-docker.html
#
# Additional ENVs:
# https://docs.searxng.org/admin/settings/settings_general.html#settings-general
# https://docs.searxng.org/admin/settings/settings_server.html#settings-server

# Use a specific version tag. E.g. "latest" or "2026.3.25-541c6c3cb".
#SEARXNG_VERSION=latest
SEARXNG_VERSION=latest

# Listen to a specific address.
#SEARXNG_HOST=[::]
#SEARXNG_HOST=[::]

# Listen to a specific port.
SEARXNG_PORT=8080
#SEARXNG_PORT=7412

# Account the tool-installer service will create (or sign into) as the first
# Open WebUI admin, and under which it installs the two Tools automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

OLLAMA_CONTEXT_LENGTH=65536




# --- GITHUB TOOLS (github-mcp service) ---
# Required: docker compose refuses to start without these two.
# Use a FINE-GRAINED personal access token limited to the repos you need
# (Contents: read, Metadata: read; add Issues / Pull requests: write only if you
# set GITHUB_READ_ONLY=0). Never commit this file.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Shared secret between Open WebUI and the github-mcp service. Generate with:
#   openssl rand -hex 32
MCPO_API_KEY=
# Optional: toolsets exposed to the model, and read-only mode (1 = read-only).
GITHUB_TOOLSETS=repos,issues,pull_requests
GITHUB_READ_ONLY=1
# Optional: pin image versions once you have a working combination.
#GITHUB_MCP_VERSION=latest
#MCPO_VERSION=main
